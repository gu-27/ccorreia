{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ccorreia",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2025-09-01",
  "durable_objects": {
    "bindings": [
      { "name": "SESSION", "class_name": "Session", "script_name": "tax-review-sessions" },
      { "name": "ROOM", "class_name": "StudyRoom", "script_name": "tax-review-sessions" }
    ]
  }
}
